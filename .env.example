# ---- Core ----
NODE_ENV=production
COMPANY_NAME="PatentSonar"
COMPANY_POSTAL_ADDRESS="<legal address, required in every email footer>"
PUBLIC_SITE_URL=https://patentsonar.com
# Caddy site address. Leave unset (":80") until DNS points to the VPS, then: "patentsonar.com, www.patentsonar.com"
SITE_ADDRESS=
SPEND_CAP_USD_PER_ACTION=50
SPEND_CAP_USD_PER_MONTH=300

# ---- Supabase (dedicated project) ----
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres

# ---- Patent data sources ----
PATENTSVIEW_API_KEY=
EPO_OPS_CONSUMER_KEY=
EPO_OPS_CONSUMER_SECRET=
GCP_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=/etc/patentsonar/gcp-sa.json

# ---- Billing / invoicing ----
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
# sandbox | production (no inline comments: systemd reads values verbatim)
PADDLE_ENVIRONMENT=sandbox
NFEIO_API_KEY=
NFEIO_COMPANY_ID=

# ---- Email ----
POSTMARK_SERVER_TOKEN=
# Stream IDs as shown in Postmark → Servers → Message Streams (defaults of a new server: outbound, broadcast, inbound)
POSTMARK_BROADCAST_STREAM=broadcast
POSTMARK_TRANSACTIONAL_STREAM=outbound
EMAIL_FROM="PatentSonar <newsletter@patentsonar.com>"
# separate domain for cold outreach
OUTREACH_FROM="<name> <name@outreach-domain>"

# ---- Founder alerts ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_FOUNDER_CHAT_ID=

# ---- Webhook server ----
WEBHOOK_PORT=8787
# HTTPS ops channel for cloud sessions (64 hex chars; generate with: openssl rand -hex 32). Same value in the cloud environment.
OPS_TOKEN=

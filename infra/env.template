# /etc/patentsonar/env — lido pelo systemd (timers, webhooks) e pelo Caddy.
# Preenchido em 2026-09-25. Substitua cada [[COLE AQUI ...]] conforme os itens chegarem.
# Regras: nunca commitar este arquivo; valores com espaço ficam entre aspas duplas.

# ---- Empresa ----
NODE_ENV=production
COMPANY_NAME="PatentSonar"
COMPANY_POSTAL_ADDRESS="[[COLE AQUI O ENDEREÇO POSTAL DO CNPJ, ex.: Rua X, 123, Cidade - UF, CEP, Brazil]]"
PUBLIC_SITE_URL=https://patentsonar.com
# Caddy: só ative a linha com o domínio DEPOIS de apontar o DNS (A @ e A www -> 2.25.249.69, "DNS only").
# Até lá deixe ":80".
SITE_ADDRESS=":80"
# SITE_ADDRESS="patentsonar.com, www.patentsonar.com"
SPEND_CAP_USD_PER_ACTION=50
SPEND_CAP_USD_PER_MONTH=300

# ---- Supabase (projeto novo e dedicado: Project Settings -> API / Database) ----
SUPABASE_URL=[[COLE AQUI O PROJECT URL, ex.: https://abcdefgh.supabase.co]]
SUPABASE_SERVICE_ROLE_KEY=[[COLE AQUI A SERVICE ROLE KEY (secret), nunca a anon key]]
SUPABASE_DB_URL=[[COLE AQUI A CONNECTION STRING (Database -> Connect -> URI, modo direto ou session pooler)]]

# ---- Fontes de dados de patente ----
PATENTSVIEW_API_KEY=[[COLE AQUI A API KEY DO PATENTSVIEW]]
EPO_OPS_CONSUMER_KEY=[[COLE AQUI O CONSUMER KEY DO EPO OPS]]
EPO_OPS_CONSUMER_SECRET=[[COLE AQUI O CONSUMER SECRET DO EPO OPS]]
GCP_PROJECT_ID=[[COLE AQUI O ID DO PROJETO GCP, ex.: patentsonar-prod]]
GOOGLE_APPLICATION_CREDENTIALS=/etc/patentsonar/gcp-sa.json

# ---- Cobrança e nota fiscal ----
PADDLE_API_KEY=[[COLE AQUI A API KEY DO PADDLE (sandbox primeiro)]]
PADDLE_WEBHOOK_SECRET=[[COLE AQUI O WEBHOOK SECRET DO PADDLE (Notifications -> Destination)]]
PADDLE_ENVIRONMENT=sandbox
NFEIO_API_KEY=[[COLE AQUI A API KEY DO NFE.IO]]
NFEIO_COMPANY_ID=[[COLE AQUI O COMPANY ID DO NFE.IO]]

# ---- E-mail ----
POSTMARK_SERVER_TOKEN=[[COLE AQUI O SERVER API TOKEN DO POSTMARK]]
POSTMARK_BROADCAST_STREAM=newsletter
POSTMARK_TRANSACTIONAL_STREAM=outbound
EMAIL_FROM="PatentSonar <newsletter@patentsonar.com>"
OUTREACH_FROM="[[COLE AQUI O REMETENTE DO DOMÍNIO DE OUTREACH, ex.: Nome <nome@patentsonar-mail.com>]]"

# ---- Alertas ao fundador ----
TELEGRAM_BOT_TOKEN=[[COLE AQUI O TOKEN DO BOT (via @BotFather)]]
TELEGRAM_FOUNDER_CHAT_ID=[[COLE AQUI O SEU CHAT ID (envie /start ao bot e veja em https://api.telegram.org/bot<TOKEN>/getUpdates)]]

# ---- Servidor de webhooks ----
WEBHOOK_PORT=8787

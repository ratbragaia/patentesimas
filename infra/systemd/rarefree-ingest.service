[Unit]
Description=RareFree Intelligence — ingest
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=rarefree
WorkingDirectory=/opt/rarefree
EnvironmentFile=/etc/rarefree/env
ExecStart=/bin/bash -lc 'npx tsx src/cli.ts ingest'
StandardOutput=append:/var/log/rarefree/ingest.log
StandardError=append:/var/log/rarefree/ingest.log

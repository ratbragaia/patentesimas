[Unit]
Description=PatentSonar — ingest
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=patentsonar
WorkingDirectory=/opt/patentsonar
EnvironmentFile=/etc/patentsonar/env
ExecStart=/bin/bash -lc 'npx tsx src/cli.ts ingest'
StandardOutput=append:/var/log/patentsonar/ingest.log
StandardError=append:/var/log/patentsonar/ingest.log

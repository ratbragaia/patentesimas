[Unit]
Description=RareFree Intelligence — report
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=rarefree
WorkingDirectory=/opt/rarefree
EnvironmentFile=/etc/rarefree/env
ExecStart=/bin/bash -lc 'npx tsx src/cli.ts report weekly'
StandardOutput=append:/var/log/rarefree/report.log
StandardError=append:/var/log/rarefree/report.log

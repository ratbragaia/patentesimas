[Unit]
Description=RareFree Intelligence — newsletter-build
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=rarefree
WorkingDirectory=/opt/rarefree
EnvironmentFile=/etc/rarefree/env
ExecStart=/bin/bash -lc 'npx tsx src/cli.ts newsletter build $(date -d 'last monday -7 days' +%F) $(date -d 'last sunday' +%F)'
StandardOutput=append:/var/log/rarefree/newsletter-build.log
StandardError=append:/var/log/rarefree/newsletter-build.log

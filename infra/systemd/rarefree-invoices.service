[Unit]
Description=RareFree Intelligence — invoices
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=rarefree
WorkingDirectory=/opt/rarefree
EnvironmentFile=/etc/rarefree/env
ExecStart=/bin/bash -lc 'npx tsx src/cli.ts invoices issue'
StandardOutput=append:/var/log/rarefree/invoices.log
StandardError=append:/var/log/rarefree/invoices.log
